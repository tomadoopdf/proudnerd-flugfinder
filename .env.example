# Kopiere diese Datei zu .env und trage deine eigenen Schlüssel ein.

# Pflicht für Chat und Pass-Scan: eigener Anthropic-API-Key (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Optional: Modell (Standard: claude-opus-5-5)
# CLAUDE_MODEL=claude-opus-5-5

# Optional, für echte Flugpreise: Duffel-Token (https://app.duffel.com, Test-Token beginnt mit duffel_test_)
DUFFEL_TOKEN=

# Optional: Zugangscode, Pflicht sobald der Server aus dem Internet erreichbar ist
APP_TOKEN=

# Optional: Port und Adresse (Standard 127.0.0.1:8787 = nur dieser Rechner)
# PORT=8787
# HOST=0.0.0.0
